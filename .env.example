# Local development defaults only. Do not use these credentials or keys in production.
POSTGRES_DB=nirikshanx
POSTGRES_USER=nirikshan
POSTGRES_PASSWORD=nirikshan_dev_only
REDIS_HOST=redis
REDIS_PORT=6379
MINIO_ROOT_USER=nirikshan-local
MINIO_ROOT_PASSWORD=change-me-local-only
MINIO_BUCKET=nirikshan-evidence
MINIO_ENDPOINT=http://minio:9000
BACKEND_INTERNAL_URL=http://backend:8080

# Authentication: replace all keys/secrets before any non-local deployment.
AUTH_ACCESS_TOKEN_TTL=PT10M
AUTH_SESSION_TTL=P30D
AUTH_MFA_CHALLENGE_TTL=PT5M
AUTH_JWT_ISSUER=nirikshanx
AUTH_JWT_AUDIENCE=nirikshanx-web
AUTH_JWT_SECRET_BASE64=ZGV2LWp3dC1zZWNyZXQtY2hhbmdlLW1lLTEyMzQ1Njc=
AUTH_MFA_ENCRYPTION_KEY_BASE64=ZGV2LW1mYS1rZXktY2hhbmdlLW1lLTEyMzQ1Njc4OTA=
AUTH_COOKIE_SECURE=false
AUTH_LOGIN_MAX_FAILURES=5
AUTH_LOGIN_WINDOW=PT15M

# Explicit local-only bootstrap user. Disable outside local/demo environments.
BOOTSTRAP_USER_ENABLED=true
BOOTSTRAP_USER_EMAIL=local.operator@nirikshanx.test
BOOTSTRAP_USER_DISPLAY_NAME=Local NirikshanX Operator
BOOTSTRAP_USER_PASSWORD=Local-NX-2026-Change!
BOOTSTRAP_USER_PREFERRED_LANGUAGE=en
